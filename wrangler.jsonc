{
  "name": "wishlist",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "keep_vars": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  // Attaches the domains on deploy (the domain's DNS is on Cloudflare). wishlist. is the retired name:
  // src/worker.js redirects it to hints. so old invite links still land somewhere.
  "routes": [
    { "pattern": "hints.alexisdavidson.org", "custom_domain": true },
    { "pattern": "wishlist.alexisdavidson.org", "custom_domain": true }
  ],
  // Notifications (src/wishlist.js runSchedule): new-wish digest every hour, reminders in the 9am New York hour.
  "triggers": { "crons": ["0 * * * *"] },
  // Deploy id, sent as x-app-version on every response so an open app can tell it's out of date (src/worker.js).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // GEMINI_DAILY_CAP: most Gemini calls the whole app makes per day (UTC), so abuse can't run up the bill.
  "vars": { "GEMINI_MODEL": "gemini-3.5-flash-lite", "GEMINI_DAILY_CAP": "1500" },
  // Per-IP burst cap on every API call and invite page (src/limits.js). Approximate, per Cloudflare location.
  // namespace_id just has to be unique in the Cloudflare account.
  "ratelimits": [
    { "name": "BURST", "namespace_id": "4821", "simple": { "limit": 240, "period": 60 } }
  ],
  // Wishlist data (D1). Schema changes: add a file to migrations/, then
  // `npx wrangler d1 migrations apply wishlist --remote`.
  "d1_databases": [
    { "binding": "DB", "database_name": "wishlist", "database_id": "7b96cbbb-eb6e-4720-9b3a-4bce9f2e2d78", "migrations_dir": "migrations" }
  ]
}
