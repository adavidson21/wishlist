{
  "name": "wishlist",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "check": "node scripts/check-routes.mjs && npm test && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy": "wrangler deploy",
    "migrate": "wrangler d1 migrations apply wishlist --remote",
    "backup": "node scripts/backup.mjs",
    "test": "node --no-warnings --test test/*.test.mjs",
    "compare-budgets": "node --no-warnings scripts/compare-budgets.mjs"
  },
  "devDependencies": {
    "miniflare": "5.20261104.0-beta",
    "wrangler": "^4"
  }
}
